# Nom de la base WordPress creee par MariaDB.
MYSQL_DATABASE=wordpress
# Utilisateur SQL applicatif (non-root).
MYSQL_USER=wp_user
# Host DB vu depuis le conteneur WordPress (nom du service Docker).
WORDPRESS_DB_HOST=mariadb
# Nom de la base cible utilisee par WordPress.
WORDPRESS_DB_NAME=wordpress
# User SQL utilise par WordPress pour se connecter.
WORDPRESS_DB_USER=wp_user
# URL publique du site (sert a configurer home/siteurl).
WP_URL=https://tcohen.42.fr
# Titre du site WordPress initialise par WP-CLI.
WP_TITLE=inception
# Login admin WordPress.
WP_ADMIN_USER=big_boss42
# Email admin WordPress.
WP_ADMIN_EMAIL=big_boss42@example.com
# Login utilisateur standard WordPress.
WP_USER_LOGIN=wp_user2
# Email utilisateur standard.
WP_USER_EMAIL=wp_user2@example.com
# Role WordPress de l'utilisateur standard (author, editor, etc.).
WP_USER_ROLE=author
